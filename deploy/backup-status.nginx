server {
    listen 80;
    server_name backup.bekat.co.uk;

    # DO NOT EDIT BELOW THIS LINE - certbot will add SSL configuration automatically
    # -------------------------------------------------------------------------------

    location / {
        proxy_pass http://unix:/opt/backup-status/backup-status.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
